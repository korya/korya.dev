---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/', label: 'Posts' },
  { href: '/resume', label: 'Resume' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <nav class="nav">
    <a href="/" class="logo">📜 Tech Scrolls</a>
    <div class="nav-links">
      {navItems.map(({ href, label }) => (
        <a
          href={href}
          class:list={['nav-link', { active: currentPath === href || (href !== '/' && currentPath.startsWith(href)) }]}
        >
          {label}
        </a>
      ))}
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .nav {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .logo:hover {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-link {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  .nav-link.active {
    font-weight: 500;
  }

  /* Four nav items plus the theme toggle no longer fit beside the logo on small
     phones, so tighten the rhythm rather than let the logo wrap. */
  @media (max-width: 30rem) {
    .nav {
      padding: var(--space-md);
    }

    .nav-links {
      gap: var(--space-md);
    }

    .logo {
      font-size: 1rem;
    }

    .nav-link {
      font-size: 0.875rem;
    }
  }
</style>
