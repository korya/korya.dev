---
import PostCard from './PostCard.astro';
import type { VideoMetadata } from '../lib/content';

interface RelatedPost {
  slug: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
  videos?: VideoMetadata[];
}

interface Props {
  posts: RelatedPost[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <aside class="related" aria-labelledby="related-posts-title">
    <h2 id="related-posts-title">Related posts</h2>
    {/* The same PostCard the index and tag pages use, so a related entry carries
        the type icon, date and tags rather than a reduced title-and-blurb.
        Reusing the component keeps the two previews from drifting apart; the
        wrapper is a plain div so PostCard's own :last-child rule still drops the
        trailing separator, which an li would break by making every card a last
        child of its own parent. */}
    <div class="related-list">
      {posts.map((post) => (
        <PostCard
          title={post.title}
          date={post.date}
          slug={post.slug}
          description={post.description}
          tags={post.tags}
          videos={post.videos}
          headingLevel={3}
        />
      ))}
    </div>
  </aside>
)}

<style>
  .related {
    margin-top: var(--space-xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  h2 {
    margin: 0 0 var(--space-sm);
    font-size: 1.25rem;
  }
</style>
