---
interface Props {
  src: string;
  /** Intrinsic pixel size. Required: without it the browser reserves no space and
   *  the rest of the page jumps down when the image arrives. Global CSS keeps
   *  `max-width: 100%; height: auto`, so these are the aspect ratio, not a lock. */
  width: number;
  height: number;
  alt?: string;
  caption?: string;
  align?: 'left' | 'center' | 'right';
  /** Set on images above the fold. Lazy-loading those delays the first paint of
   *  the thing the reader came for. */
  eager?: boolean;
}

const { src, width, height, alt = '', caption, align = 'center', eager = false } = Astro.props;
---

<figure class:list={['figure', `align-${align}`]}>
  <img
    src={src}
    width={width}
    height={height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: var(--space-lg) 0;
  }

  .figure img {
    border-radius: 8px;
  }

  .align-center {
    text-align: center;
  }

  .align-center img {
    margin: 0 auto;
  }

  .align-left {
    text-align: left;
  }

  .align-right {
    text-align: right;
  }

  .align-right img {
    margin-left: auto;
  }

  figcaption {
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
