---
interface Props {
  title: string;
  date: Date;
  slug: string;
  tags?: string[];
  /** Present on video posts. Its absence is what marks a post as text. */
  videoLength?: string;
}

const { title, date, slug, tags = [], videoLength } = Astro.props;

const isVideo = Boolean(videoLength);

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card" data-type={isVideo ? 'video' : 'text'}>
  {/* One link over both the icon and the title, rather than a second link on the
      icon: two links to the same post would be announced twice. The icon keeps its
      label, so the link reads as "Video post <title>". */}
  <a href={`/posts/${slug}`} class="post-link">
    <span class="post-icon" role="img" aria-label={isVideo ? 'Video post' : 'Written post'}>
      {isVideo ? (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9" />
          <path d="M10.2 8.4 15.6 12l-5.4 3.6z" />
        </svg>
      ) : (
        /* Runs wider and taller than a literal page would: a portrait rectangle
           reads lighter than the circle beside it at matching bounds. */
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.5 2.8H6.8a2 2 0 0 0-2 2v14.4a2 2 0 0 0 2 2h10.4a2 2 0 0 0 2-2V7.5z" />
          <path d="M14.5 2.8v4.7h4.7" />
          <path d="M8.5 13h7M8.5 16.6h4.5" />
        </svg>
      )}
    </span>
    <h2 class="post-title">{title}</h2>
  </a>
  <div class="post-meta">
    <time datetime={date.toISOString()}>{formattedDate}</time>
    {tags.length > 0 && (
      <span class="tags">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`} class="tag">#{tag}</a>
        ))}
      </span>
    )}
  </div>
</article>

<style>
  .post-card {
    /* Fixed rather than auto, because the meta row indents by the same amount
       without being part of the link's grid. */
    --icon-col: 1.125rem;
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* .is-last is set by the filter script, which knows which card is last once
     some of them are hidden. :last-child alone would leave a rule dangling under
     the final visible entry. */
  .post-card:last-child,
  .post-card.is-last {
    border-bottom: none;
  }

  /* The link is the grid: icon in column one, title in column two, so the whole
     of both is clickable and a wrapped title never runs back under the icon. */
  .post-link {
    display: grid;
    grid-template-columns: var(--icon-col) 1fr;
    column-gap: var(--space-md);
    text-decoration: none;
  }

  .post-icon {
    display: flex;
    align-items: center;
    /* Matches the title's line box, which centres the glyph on the first line
       however many lines the title runs to. */
    height: calc(1.25rem * 1.4);
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .post-icon svg {
    width: var(--icon-col);
    height: var(--icon-col);
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    line-height: 1.4;
    transition: color 0.15s ease;
  }

  .post-link:hover .post-title,
  .post-link:hover .post-icon {
    color: var(--color-accent);
  }

  .post-meta {
    /* Lines up with the title rather than the icon, matching the link's grid. */
    margin-left: calc(var(--icon-col) + var(--space-md));
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    gap: var(--space-sm);
  }

  .tag {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .tag:hover {
    color: var(--color-accent);
  }
</style>
