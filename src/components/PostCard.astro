---
interface Props {
  title: string;
  date: Date;
  slug: string;
  tags?: string[];
  /** Present on video posts. Its absence is what marks a post as text. */
  videoLength?: string;
}

const { title, date, slug, tags = [], videoLength } = Astro.props;

const isVideo = Boolean(videoLength);

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  {/* The icon is the only signal of post type in this list, so it carries a label
      rather than aria-hidden. */}
  <span class="post-icon" role="img" aria-label={isVideo ? 'Video post' : 'Written post'}>
    {isVideo ? (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M10.2 8.4 15.6 12l-5.4 3.6z" />
      </svg>
    ) : (
      /* Runs wider and taller than a literal page would: a portrait rectangle
         reads lighter than the circle beside it at matching bounds. */
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.5 2.8H6.8a2 2 0 0 0-2 2v14.4a2 2 0 0 0 2 2h10.4a2 2 0 0 0 2-2V7.5z" />
        <path d="M14.5 2.8v4.7h4.7" />
        <path d="M8.5 13h7M8.5 16.6h4.5" />
      </svg>
    )}
  </span>
  <a href={`/posts/${slug}`} class="post-link">
    <h2 class="post-title">{title}</h2>
  </a>
  <div class="post-meta">
    <time datetime={date.toISOString()}>{formattedDate}</time>
    {tags.length > 0 && (
      <span class="tags">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`} class="tag">#{tag}</a>
        ))}
      </span>
    )}
  </div>
</article>

<style>
  .post-card {
    /* Icon owns the first column; title and meta share the second, so a title
       that wraps stays aligned with the date beneath it. */
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-md);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-card:last-child {
    border-bottom: none;
  }

  .post-icon {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    align-items: center;
    /* Matches the title's line box, which centres the glyph on the first line
       however many lines the title runs to. */
    height: calc(1.25rem * 1.4);
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .post-icon svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .post-link {
    grid-column: 2;
    grid-row: 1;
    text-decoration: none;
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    line-height: 1.4;
    transition: color 0.15s ease;
  }

  .post-link:hover .post-title {
    color: var(--color-accent);
  }

  /* The icon sits outside the link and before it, so no sibling selector reaches
     it. :has() ties it to the title's own hover, rather than the whole row: the
     two lighting up at different moments is what would read as a bug. */
  .post-card:has(.post-link:hover) .post-icon {
    color: var(--color-accent);
  }

  .post-meta {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    gap: var(--space-sm);
  }

  .tag {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .tag:hover {
    color: var(--color-accent);
  }
</style>
