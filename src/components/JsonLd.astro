---
import { SITE_CONFIG } from '../config';
import type { ContentImage, VideoMetadata } from '../lib/content';

interface Props {
  type: 'BlogPosting' | 'WebSite';
  title?: string;
  description?: string;
  date?: Date;
  updated?: Date;
  tags?: string[];
  wordCount?: number;
  url?: string;
  image?: ContentImage;
  videos?: VideoMetadata[];
}

const {
  type,
  title,
  description,
  date,
  updated,
  tags,
  wordCount,
  url,
  image,
  videos = [],
} = Astro.props;
const absoluteURL = (path: string) => new URL(path, SITE_CONFIG.SITE_URL).href;

function generateBlogPostingSchema() {
  return {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: description,
    datePublished: date?.toISOString(),
    ...(updated && { dateModified: updated.toISOString() }),
    ...(image && { image: [absoluteURL(image.src)] }),
    author: {
      '@type': 'Person',
      '@id': SITE_CONFIG.AUTHOR.id,
      name: SITE_CONFIG.AUTHOR.name,
      url: SITE_CONFIG.AUTHOR.url,
    },
    publisher: {
      '@type': 'Person',
      '@id': SITE_CONFIG.AUTHOR.id,
      name: SITE_CONFIG.AUTHOR.name,
      url: SITE_CONFIG.AUTHOR.url,
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': url,
    },
    ...(wordCount && { wordCount }),
    ...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
    ...(videos.length > 0 && {
      video: videos.map((video, index) => ({
        '@type': 'VideoObject',
        '@id': `${url}#video-${index + 1}`,
        name: video.title,
        description: video.description,
        thumbnailUrl: [absoluteURL(video.thumbnail.src)],
        uploadDate: video.uploadDate,
        duration: video.duration,
        embedUrl: `https://www.youtube-nocookie.com/embed/${video.youtubeId}`,
      })),
    }),
  };
}

function generateWebSiteSchema() {
  return {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_CONFIG.SITE_TITLE,
    description: SITE_CONFIG.SITE_DESCRIPTION,
    url: SITE_CONFIG.SITE_URL,
    author: {
      '@type': 'Person',
      '@id': SITE_CONFIG.AUTHOR.id,
      name: SITE_CONFIG.AUTHOR.name,
      url: SITE_CONFIG.AUTHOR.url,
    },
  };
}

function generateBreadcrumbSchema() {
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: SITE_CONFIG.SITE_URL,
      },
      ...(title
        ? [
            {
              '@type': 'ListItem',
              position: 2,
              name: title,
              item: url,
            },
          ]
        : []),
    ],
  };
}

const schema =
  type === 'BlogPosting'
    ? [generateBlogPostingSchema(), generateBreadcrumbSchema()]
    : [generateWebSiteSchema()];
---

{schema.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
