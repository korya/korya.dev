---
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/interactive/Figure.astro';
import styles from '../styles/prose.module.css';
import { SITE_CONFIG } from '../config';
import { PROFILE } from '../data/resume';

// The page a reader lands on to find out who Dmitri is, so it carries the canonical
// Person node rather than only prose. Companies are affiliations, not sameAs: sameAs
// is for other profiles of this same person. /resume describes the same node in more
// depth; both use the id below, so the two pages describe one person, not two.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    '@id': SITE_CONFIG.AUTHOR.id,
    name: 'Dmitri Kochelorov',
    alternateName: SITE_CONFIG.AUTHOR.name,
    url: SITE_CONFIG.AUTHOR.url,
    jobTitle: `${PROFILE.currentRole.title}, ${PROFILE.currentRole.company}`,
    worksFor: {
      '@type': 'Organization',
      name: PROFILE.currentRole.company,
      url: PROFILE.currentRole.href,
    },
    affiliation: {
      '@type': 'Organization',
      '@id': SITE_CONFIG.ORGS.COSMIC_LIFT.id,
      name: SITE_CONFIG.ORGS.COSMIC_LIFT.name,
      url: SITE_CONFIG.ORGS.COSMIC_LIFT.url,
    },
    sameAs: [
      'https://github.com/korya',
      'https://x.com/korya_dev',
      'https://www.linkedin.com/in/kochelorov/',
    ],
  },
};
---

<BaseLayout
  title="About Dmitri Kochelorov | Tech Scrolls"
  description="Dmitri Kochelorov is a software engineer, co-founder of FrontSail AI, and fractional CTO writing about AI agents, engineering, and tools."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personSchema)} />
  <article class="about">
    <h1 class="page-title">About</h1>

    <Figure
      src="/profile.jpg"
      width={400}
      height={512}
      alt="Dmitri Kochelorov in his garage workshop, a reciprocating saw resting on his shoulder"
      align="center"
      eager
    />

    <div class={styles.prose}>
      <p>
        I'm Dmitri, a 0→1 builder. I co-founded <a href="https://frontsail.ai/" target="_blank" rel="noopener noreferrer">FrontSail AI</a>,
        where we build an agentic operating system that takes the repetitive
        back-office work off small businesses' hands.
      </p>

      <p>
        Alongside that I run <a href="https://cosmic-lift.com/" target="_blank" rel="noopener noreferrer">Cosmic Lift</a>,
        my consulting practice. Fractional CTO work, training, and product architecture
        and development for companies going AI-first, or making what they already have
        AI-ready.
      </p>

      <p>
        Before that I spent a decade at <a href="https://goiguide.com/" target="_blank" rel="noopener noreferrer">Planitar</a>.
        I joined as the first engineer and left as R&D director of a 20-person org,
        then went back to writing code full time so I could build AI agents myself.
        The longer version is on my <a href="/resume/">resume</a>.
      </p>

      <p>
        This is my personal blog containing my thoughts and some fragments of thoughts on tech topics.
      </p>

      <p>
        The idea behind this blog is to reflect and structure the information in my head. Writing is one of the best ways to achieve that.
      </p>

      <p>
        I will be glad if you find it useful or even better, inspiring.
      </p>

      <h2>Contact</h2>
      <ul>
        <li>Consulting: <a href="https://cosmic-lift.com/" target="_blank" rel="noopener noreferrer">Cosmic Lift</a></li>
        <li>Github: <a href="https://github.com/korya" target="_blank" rel="noopener noreferrer">@korya</a></li>
        <li>X/Twitter: <a href="https://x.com/korya_dev" target="_blank" rel="noopener noreferrer">@korya_dev</a></li>
        <li>LinkedIn: <a href="https://www.linkedin.com/in/kochelorov/" target="_blank" rel="noopener noreferrer">kochelorov</a></li>
      </ul>
    </div>
  </article>
</BaseLayout>

<style>
  .about {
    max-width: var(--content-width);
  }

  .page-title {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: var(--space-lg);
  }
</style>
