---
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/interactive/Figure.astro';
import styles from '../styles/prose.module.css';
import { BIO, CONTACT } from '../data/about';

/** External links get the usual noopener treatment; in-site ones must not. */
const isExternal = (href: string) => href.startsWith('http');
---

<BaseLayout title="About | Tech Scrolls">
  <article class="about">
    <h1 class="page-title">About</h1>

    <Figure src="/profile.png" align="center" />

    <div class={styles.prose}>
      {BIO.map((paragraph) => (
        <p>
          {paragraph.map((segment) =>
            segment.href ? (
              isExternal(segment.href) ? (
                <a href={segment.href} target="_blank" rel="noopener noreferrer">{segment.text}</a>
              ) : (
                <a href={segment.href}>{segment.text}</a>
              )
            ) : (
              segment.text
            )
          )}
        </p>
      ))}

      <h2>Contact</h2>
      <ul>
        {CONTACT.map((link) => (
          <li>
            {link.platform}: <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </article>
</BaseLayout>

<style>
  .about {
    max-width: var(--content-width);
  }

  .page-title {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: var(--space-lg);
  }
</style>
